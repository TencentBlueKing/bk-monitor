%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#e8f5e9', 'primaryTextColor': '#2e7d32', 'primaryBorderColor': '#4caf50', 'lineColor': '#81c784'}}}%%
graph TB
  USER[用户访问浏览器]
  subgraph SHELL[静态壳层 index.html]
    HTML[文档壳 / favicon / title]
    LOADING[bootstrap-loading<br/>首屏占位与阶段文案]
    APPMOUNT["#app 挂载点"]
  end
  subgraph BOOT[启动编排层]
    MAIN[main.js]
    PRELOAD[preload.ts<br/>空间 / 用户 / globals]
    FADE[fadeOutBootstrapLoading<br/>App.mounted 后移除占位]
  end
  subgraph VIEW[视图与路由层]
    ROUTER[router]
    HUB[retrieve-hub]
    V3[retrieve-v3]
    RESULT[结果组件<br/>V3 + 部分 V2 复用]
  end
  subgraph STATE[状态编排层]
    STORE[Vuex]
    ACTIONS[retrieve-search-actions]
    REQUESTPOOL[RequestPool / 竞态控制]
  end
  subgraph SERVICE[服务与缓存层]
    API[api + services]
    FIELDS[字段元数据缓存]
    ROWCACHE[行缓存服务]
    HEALTH[存储健康与降级]
  end
  subgraph WORKER[检索执行层]
    WS[Worker 管理服务]
    WW[WebWorker<br/>fetch / NDJSON / JSON]
  end
  subgraph STORAGE[浏览器持久化层]
    REPO[行仓储]
    IDB[(Dexie IndexedDB)]
  end
  BACKEND[/BKLog Search API/]

  USER --> HTML
  HTML --> LOADING
  HTML --> APPMOUNT
  APPMOUNT --> MAIN
  MAIN --> PRELOAD
  PRELOAD --> STORE
  PRELOAD --> API
  MAIN --> ROUTER
  MAIN --> FADE
  FADE -.->|移除| LOADING
  ROUTER --> HUB --> V3 --> RESULT
  V3 --> STORE
  STORE --> ACTIONS
  ACTIONS --> REQUESTPOOL
  ACTIONS --> API
  ACTIONS --> FIELDS
  ACTIONS --> WS
  API --> BACKEND
  WS --> WW --> BACKEND
  WW --> REPO --> IDB
  FIELDS --> IDB
  RESULT --> ROWCACHE --> IDB
  HEALTH --> ROWCACHE
  HEALTH --> REPO
  STORE --> RESULT
