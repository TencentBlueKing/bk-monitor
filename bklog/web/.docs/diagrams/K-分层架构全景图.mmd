%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#e8f5e9', 'primaryTextColor': '#2e7d32', 'primaryBorderColor': '#4caf50', 'lineColor': '#81c784'}}}%%
graph TB
  USER[用户交互]
  subgraph VIEW[视图与路由层]
    ROUTER[router]
    HUB[retrieve-hub]
    V3[retrieve-v3]
    RESULT[结果组件<br/>V3 + 部分 V2 复用]
  end
  subgraph STATE[状态编排层]
    STORE[Vuex]
    ACTIONS[retrieve-search-actions]
    REQUESTPOOL[RequestPool / 竞态控制]
  end
  subgraph SERVICE[服务与缓存层]
    API[api + services]
    FIELDS[字段元数据缓存]
    ROWCACHE[行缓存服务]
    HEALTH[存储健康与降级]
  end
  subgraph WORKER[检索执行层]
    WS[Worker 管理服务]
    WW[WebWorker<br/>fetch / NDJSON / JSON]
  end
  subgraph STORAGE[浏览器持久化层]
    REPO[行仓储]
    IDB[(Dexie IndexedDB)]
  end
  BACKEND[/BKLog Search API/]

  USER --> ROUTER --> HUB --> V3 --> RESULT
  V3 --> STORE
  STORE --> ACTIONS
  ACTIONS --> REQUESTPOOL
  ACTIONS --> API
  ACTIONS --> FIELDS
  ACTIONS --> WS
  API --> BACKEND
  WS --> WW --> BACKEND
  WW --> REPO --> IDB
  FIELDS --> IDB
  RESULT --> ROWCACHE --> IDB
  HEALTH --> ROWCACHE
  HEALTH --> REPO
  STORE --> RESULT
