flowchart TB
    subgraph "主线程 HTTP 调用 (preload / 字段 / 菜单等)"
        CALL["http.request('meta/menu' | 'space/getMySpaceList' | ...)"]
        SERVICES["services/index.js<br/>聚合所有 service 模块"]
        META["services/*.js|ts<br/>export const xxx = { url, method }"]
        API["api/index.js<br/>baseURL: '/api/v1'<br/>+ interceptors + cancel/cache"]
        REQ["GET|POST /api/v1/..."]
        CALL --> SERVICES --> META --> API --> REQ
    end

    subgraph "检索主查询旁路 (V3 Worker)"
        ACTION["retrieve-search-actions<br/>组装 URL / body / headers"]
        WS["retrieve-search-worker.service"]
        WW["WebWorker fetch<br/>/search/*?stream=true"]
        NOTE["不经过 http.request 的 API Key 查找<br/>但仍复用同一后端 Search API 前缀"]
        ACTION --> WS --> WW
        WW -.-> NOTE
    end

    REQ --> BACKEND[/BKLog Backend/]
    WW --> BACKEND
