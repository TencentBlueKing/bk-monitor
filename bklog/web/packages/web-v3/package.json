{
  "name": "@bklog/web-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "description": "BKLog Vue 3 workspace package",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build && node tools/verify-legacy-deployment.mjs",
    "test": "pnpm --ignore-workspace i18n:compile && node --test tests/*.test.mjs",
    "typecheck": "pnpm --ignore-workspace i18n:compile && vue-tsc --noEmit",
    "ai:check": "node tools/ai-native.mjs check",
    "ai:context": "node tools/ai-native.mjs context",
    "ai:impact": "node tools/ai-native.mjs impact",
    "ai:index": "node tools/ai-native.mjs index",
    "typecheck:regression": "node tools/typecheck-regression.mjs",
    "verify": "pnpm --ignore-workspace check:boundaries && pnpm --ignore-workspace ai:check && pnpm --ignore-workspace test && pnpm --ignore-workspace build",
    "build:apm": "MONITOR_APP=apm node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --config vite.monitor.config.ts && node tools/verify-monitor-build.mjs apm",
    "build:trace": "MONITOR_APP=trace node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --config vite.monitor.config.ts && node tools/verify-monitor-build.mjs trace",
    "check:source": "node tools/check-source-layout.mjs",
    "package:apm": "node tools/package-monitor.mjs apm",
    "package:trace": "node tools/package-monitor.mjs trace",
    "i18n:compile": "node tools/compile-messages.mjs",
    "check:tdesign": "node tools/business-control-audit.mjs",
    "check:boundaries": "node tools/third-party-boundary-audit.mjs"
  },
  "dependencies": {
    "@blueking/ai-blueking": "1.3.0-beta.2",
    "@blueking/bk-user-display-name": "1.0.3-beta.5",
    "@blueking/bk-user-selector": "0.0.38-beta.5",
    "@blueking/bkui-library": "0.0.0-beta.5",
    "@blueking/date-picker": "4.0.0-beta.9",
    "@blueking/ip-selector": "1.0.1-beta.19",
    "@blueking/log-web": "0.0.13",
    "@blueking/login-modal": "1.0.1",
    "@blueking/login-userinfo": "0.0.13",
    "@blueking/notice-component": "2.0.8",
    "@blueking/open-telemetry": "^0.0.31",
    "@blueking/platform-config": "1.0.2",
    "@blueking/user-selector": "1.0.12",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "6.0.1",
    "@codemirror/lang-sql": "6.7.1",
    "@codemirror/language": "6.10.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@vue/devtools-api": "8.2.1",
    "axios": "1.15.2",
    "codemirror": "6.0.1",
    "core-js": "3.38.0",
    "dayjs": "1.11.10",
    "deepmerge": "4.3.1",
    "dexie": "^4.4.3",
    "dompurify": "^3.2.6",
    "echarts": "5.2.2",
    "interactjs": "1.10.27",
    "js-cookie": "3.0.5",
    "json-bigint": "^1.0.0",
    "json-bignumber": "1.1.1",
    "lodash": "4.17.21",
    "lodash-es": "4.17.21",
    "mark.js": "8.11.1",
    "monaco-editor": "0.33.0",
    "monaco-yaml": "4.0.0-alpha.3",
    "pinia": "4.1.0",
    "pixi.js": "8.18.1",
    "qs": "6.11.2",
    "resize-detector": "0.3.0",
    "scheduler-polyfill": "^1.3.0",
    "screenfull": "6.0.2",
    "sql-formatter": "15.6.6",
    "tdesign-vue-next": "^1.20.10",
    "throttle-debounce": "5.0.0",
    "tiny-pinyin": "1.3.2",
    "tippy.js": "6.3.7",
    "vue": "^3.5.13",
    "vue-class-component": "7.2.6",
    "vue-json-pretty": "1.9.5",
    "vue-property-decorator": "9.1.2",
    "vue-router": "^4.5.0",
    "vue-text-highlight": "2.0.10",
    "vue-tsx-support": "3.1.0",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "vuedraggable": "2.24.3",
    "vuedraggable-vue3": "npm:vuedraggable@4.1.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.11",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/traverse": "7.29.10",
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-message-format": "4.5.0",
    "@inlang/sdk": "4.0.4",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "4.2.0",
    "@vue/compat": "3.5.44",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/server-renderer": "3.5.44",
    "esbuild": "0.25.12",
    "ifdef-loader": "2.3.2",
    "path-browserify": "1.0.1",
    "pngjs": "^7.0.0",
    "postcss": "8.5.32",
    "sass": "^1.106.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vue-i18n": "11.4.16",
    "vue-tsc": "^3.3.13",
    "vuex": "4.1.0"
  },
  "imports": {
    "#paraglide/*": "./.paraglide/*"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "bkui-vue",
        "bk-magic-vue",
        "babel-plugin-import-bk-magic-vue"
      ],
      "allowedVersions": {
        "vue": "3",
        "vue-router": "4",
        "vuex": "4"
      }
    }
  }
}
