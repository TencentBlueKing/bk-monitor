{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature.schema.json",
  "title": "Feature Contract",
  "type": "object",
  "required": ["id", "version", "title", "status", "goal", "inputs", "rules", "dependencies", "acceptance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^feature\\.[a-z0-9-]+$" },
    "version": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "approved", "deprecated"] },
    "goal": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "rules": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{3}$" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    }
  }
}
