{
  "id": "ui.retrieve-search",
  "component": "RetrievePage",
  "states": ["idle", "loading", "success", "empty", "error"],
  "transitions": [
    { "from": "idle", "event": "SEARCH", "to": "loading" },
    { "from": "loading", "event": "RESOLVE_WITH_RESULTS", "to": "success" },
    { "from": "loading", "event": "RESOLVE_EMPTY", "to": "empty" },
    { "from": "loading", "event": "REJECT", "to": "error" }
  ]
}
