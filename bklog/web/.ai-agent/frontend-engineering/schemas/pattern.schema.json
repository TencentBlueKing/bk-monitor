{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pattern.schema.json",
  "title": "A single design pattern in the catalog",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": [
        "architecture",
        "creational",
        "structural",
        "behavioral",
        "state",
        "component",
        "data",
        "async",
        "rendering",
        "performance",
        "resilience",
        "integration",
        "module",
        "event",
        "testing",
        "migration"
      ]
    },
    "role": {
      "type": "string",
      "description": "The responsibility this pattern takes in a composition."
    },
    "problem": {
      "type": "string"
    },
    "justifiedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "Minimum problem complexity below which this pattern is over-engineering."
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflictsWith": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "domain",
    "role",
    "problem"
  ],
  "additionalProperties": true
}
