{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "problem.schema.json",
  "title": "A problem identified before any pattern is named",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "request",
        "project"
      ]
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "architecture",
          "creational",
          "structural",
          "behavioral",
          "state",
          "component",
          "data",
          "async",
          "rendering",
          "performance",
          "resilience",
          "integration",
          "module",
          "event",
          "testing",
          "migration"
        ]
      }
    },
    "complexity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "kind",
    "text",
    "source"
  ],
  "additionalProperties": true
}
