            "maximum": 1
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "description": "Traceable support for this claim. Empty means the concept is inferred.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "source",
                    "test",
                    "doc",
                    "api",
                    "database",
                    "user"
                  ]
                },
                "file": {
                  "type": "string"
                },
