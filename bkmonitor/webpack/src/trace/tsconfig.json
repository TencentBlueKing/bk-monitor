{
  "include": [
    "./**/*.ts",
    "./**/*.vue",
    "./**/*.tsx",
    "./pages/host/workers/host-list.worker.raw.js",
    "./pages/host/workers/host-topo-tree.worker.raw.js"
  ],
  "exclude": ["node_modules"],
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "strict": true,
    "strictBindCallApply": true,
    "strictNullChecks": false,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@router/*": ["./router/*"],
      "@store/*": ["./store/*"],
      "@page/*": ["./pages/*"],
      "@static/*": ["./static/*"]
    }
  }
}
