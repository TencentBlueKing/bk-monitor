# Fill the target deployment configuration; keep real values in the local .env.
# Trusted package index provided by the platform for local validation setup.
export BKAI_PIP_INDEX_URL=
export BKAI_SPACE_ID=
export BKAI_APP_CODE=
export BKAI_APP_SECRET=
export BKAI_USERNAME=
export BK_API_URL_TMPL='https://gateway.example.com/api/{api_name}/{stage}'
# Optional complete endpoint override, including the gateway stage.
export BKAI_BASE_URL=
export BKPAAS_MULTI_TENANT_MODE=false
export BKAI_TENANT_ID=
# Platform-provided image with bkai-init 0.1.6, used by make build.
export BKAI_INIT_IMAGE=
